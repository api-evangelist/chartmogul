{
  "opencollection": "1.0.0",
  "info": {
    "name": "ChartMogul REST Account API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.chartmogul.com/v1/account"
          },
          "docs": "Retrieve account"
        }
      ]
    }
  ],
  "bundled": true
}